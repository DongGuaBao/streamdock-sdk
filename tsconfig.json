{
    "compilerOptions": {
        "types": ["node"],
        "target": "es2021",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "skipLibCheck": true,
        "verbatimModuleSyntax": true
    },
    "include": ["src/types.ts", "src/**/*.ts", "./tsdown.config.ts"]
}
